# Throw-away values for the e2e stack only. Never use them anywhere else.
COMPOSE_PROJECT_NAME=cre-e2e
PUBLIC_BASE_URL=https://localhost
APP_ENV=production
SESSION_SECRET=e2e-only-session-secret-0123456789abcdef0123456789abcdef
SESSION_TTL=12h
REMEMBER_TTL=30d

POSTGRES_USER=cre_owner
POSTGRES_PASSWORD=e2e-db-password
POSTGRES_DB=cre
APP_DB_PASSWORD=e2e-app
MIGRATE_DATABASE_URL=postgres://cre_owner:e2e-db-password@db:5432/cre?sslmode=disable
DATABASE_URL=postgres://cre_app:e2e-app@db:5432/cre?sslmode=disable

# api and worker refuse to start as a role that can modify audit_log.
DB_REQUIRE_APP_ROLE=true
VALKEY_ADDR=valkey:6379

S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1
S3_BUCKET=cre
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=e2e-rustfs-secret

GOTENBERG_URL=http://gotenberg:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost
# Production mode requires STARTTLS by default; Mailpit offers none.
SMTP_REQUIRE_TLS=false

SCORE_DECIMALS=2
RM_DECIMALS=3
