{
	# Local TLS: Caddy's internal CA issues the localhost certificate.
	local_certs
}

localhost {
	# The API serves its liveness probe at /healthz, outside the /api/v1 prefix.
	handle /api/v1/healthz {
		rewrite * /healthz
		reverse_proxy api:4000
	}

	handle /api/v* {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy web:3000
	}
}
