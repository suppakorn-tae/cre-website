# Production template. Run deploy/init-env.sh on the server to write .env.prod
# from it (never commit .env.prod). The script generates the secrets and fills
# the database URLs; fill every other CHANGEME by hand or answer its prompts.
# Without the script: copy to .env.prod and replace every CHANGEME.
# Used with compose.prod.yaml; see docs/runbooks/deploy.md.
# Start from .env.example for the variables not listed here (SESSION_TTL,
# SCORE_DECIMALS, RM_DECIMALS, GOTENBERG_URL, VALKEY_ADDR, S3_ENDPOINT...).

# No "dev" profile: it would start Mailpit. The backup wrapper adds "backup".
COMPOSE_PROFILES=
BACKUP_ENABLED=true

# Images: ghcr.io/<owner>/<repo>, tag = full git SHA of a release workflow run
IMAGE_REGISTRY=ghcr.io/CHANGEME-owner/CHANGEME-repo
IMAGE_TAG=CHANGEME-40-char-git-sha

PUBLIC_BASE_URL=https://conriskexpert.com
SITE_ADDRESS=conriskexpert.com
ACME_EMAIL=CHANGEME-ops@conriskexpert.com
APP_ENV=production
SESSION_SECRET=CHANGEME-openssl-rand-hex-32

# PostgreSQL / RustFS
# cre_owner owns the schema and is used only by migrate. The api and worker
# connect as cre_app, which cannot UPDATE or DELETE audit_log. migrate sets
# the cre_app password from APP_DB_PASSWORD on every start: keep it equal to
# the password in DATABASE_URL, different from POSTGRES_PASSWORD, and use a
# value that needs no URL escaping (`openssl rand -hex 24`).
POSTGRES_USER=cre_owner
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=cre
APP_DB_PASSWORD=CHANGEME-openssl-rand-hex-24
MIGRATE_DATABASE_URL=postgres://cre_owner:CHANGEME@db:5432/cre?sslmode=disable
DATABASE_URL=postgres://cre_app:CHANGEME-openssl-rand-hex-24@db:5432/cre?sslmode=disable
VALKEY_ADDR=valkey:6379
S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1
S3_BUCKET=cre
S3_ACCESS_KEY=CHANGEME
S3_SECRET_KEY=CHANGEME
GOTENBERG_URL=http://gotenberg:3000
SESSION_TTL=12h
REMEMBER_TTL=30d
SCORE_DECIMALS=2
RM_DECIMALS=3

# Google sign-in. Redirect URI https://conriskexpert.com/api/v1/auth/google/callback
# JavaScript origin https://conriskexpert.com
GOOGLE_CLIENT_ID=CHANGEME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGEME
# Optional. Default: PUBLIC_BASE_URL + /api/v1/auth/google/callback. Set it
# only when the registered callback differs; it must match the console.
# GOOGLE_REDIRECT_URL=

# Optional rate limits (<NAME>_LIMIT requests per <NAME>_WINDOW). The values
# shown are the defaults compose.prod.yaml applies when unset.
# RL_REPORT_REQUEST_LIMIT=10
# RL_REPORT_REQUEST_WINDOW=10m
# RL_GOOGLE_IP_LIMIT=30
# RL_GOOGLE_IP_WINDOW=15m

# Brevo SMTP relay (STARTTLS, 587). User is the Brevo SMTP login, password
# is an SMTP key, not the account password.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=CHANGEME
SMTP_PASSWORD=CHANGEME
SMTP_FROM=no-reply@conriskexpert.com

# Off-site backup (different provider or region from the app host)
BACKUP_S3_ENDPOINT=CHANGEME
BACKUP_S3_REGION=CHANGEME
BACKUP_S3_BUCKET=CHANGEME
BACKUP_S3_KEY=CHANGEME
BACKUP_S3_SECRET=CHANGEME
BACKUP_LOCK_S3_BUCKET=CHANGEME
BACKUP_CIPHER_PASS=CHANGEME-at-least-16-chars
