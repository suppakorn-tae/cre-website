# Copy to deploy/compose/.env. Local defaults only; never commit real secrets.
COMPOSE_PROFILES=dev
BACKUP_ENABLED=false

PUBLIC_BASE_URL=https://localhost

# PostgreSQL. POSTGRES_USER is the schema owner (a superuser in the image):
# only migrate connects as it (MIGRATE_DATABASE_URL). The api and worker
# connect as the limited role cre_app (DATABASE_URL), which cannot UPDATE or
# DELETE audit_log. migrate sets cre_app's password from APP_DB_PASSWORD on
# every start, so APP_DB_PASSWORD must equal the password in DATABASE_URL
# (percent-encode it there; hex from `openssl rand -hex 24` needs no escaping).
POSTGRES_USER=cre_owner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cre
APP_DB_PASSWORD=change-me-app
MIGRATE_DATABASE_URL=postgres://cre_owner:change-me@db:5432/cre?sslmode=disable
DATABASE_URL=postgres://cre_app:change-me-app@db:5432/cre?sslmode=disable

VALKEY_ADDR=valkey:6379

# RustFS (S3 API)
S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1
S3_BUCKET=cre
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=change-me-too

GOTENBERG_URL=http://gotenberg:3000

# Google sign-in. Leave both empty in local dev: /api/v1/auth/google/*
# then answers 503 google_unavailable. Create the OAuth client as in
# docs/runbooks/deploy.md; never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to PUBLIC_BASE_URL + /api/v1/auth/google/callback.
# GOOGLE_REDIRECT_URL=

# Mailpit in dev; Brevo SMTP relay in production
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost

# production (the default) makes the api refuse to start without
# SESSION_SECRET. development is for local http only: it drops the Secure
# flag from the cookies, and with an empty SESSION_SECRET the api signs with
# a fresh random secret per start, which ends all sessions on every restart.
APP_ENV=production
# Signs session tokens. At least 32 bytes, for example `openssl rand -hex 32`.
# Required in production; an empty value fails startup instead of silently
# rotating the secret.
SESSION_SECRET=
SESSION_TTL=12h
REMEMBER_TTL=30d
# Comma-separated origins the CSRF check accepts besides the request host.
# Leave unset to use PUBLIC_BASE_URL (compose expands it; env_file does not
# expand ${...}, so never write ${PUBLIC_BASE_URL} here).
# ALLOWED_ORIGINS=https://localhost
# Rate limits: each auth route names its limiter (for example RL_LOGIN_IP)
# and sets default limits in code. Override with <NAME>_LIMIT (requests) and
# <NAME>_WINDOW (a Go duration such as 15m), for example:
# RL_LOGIN_IP_LIMIT=20
# RL_LOGIN_IP_WINDOW=15m
# Google start and complete: RL_GOOGLE_IP (30 per 15m per IP). Report
# requests: RL_REPORT_REQUEST (10 per 10m per account).
# Compose passes only the variables listed in compose.yaml: add a new RL_*
# variable to the api environment there when you set it.

# Worker concurrency per queue (positive integer); unset uses the default.
# WORKER_REPORTS_CONCURRENCY=
# WORKER_EXPORTS_CONCURRENCY=

# Job time limits (Go durations). The worker fails a job that runs longer
# than its limit. A sweep every 10 minutes then fails any job still running
# past limit + margin (its worker died), and any job queued longer than the
# max age, with the error "timed out". The sweep runs on its own small
# "maintenance" queue. The worker refuses to start when EXPORT_TIMEOUT or
# REPORT_TIMEOUT is 30m or more, the task limit asynq sets when the api
# enqueues the job.
# EXPORT_TIMEOUT=25m
# REPORT_TIMEOUT=5m
# JOB_STUCK_MARGIN=10m
# JOB_QUEUED_MAX_AGE=6h
# Compose passes these four to the worker with the defaults shown.

SCORE_DECIMALS=2
RM_DECIMALS=3
