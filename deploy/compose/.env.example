# Copy to deploy/compose/.env. Local defaults only; never commit real secrets.
COMPOSE_PROFILES=dev
BACKUP_ENABLED=false

PUBLIC_BASE_URL=https://localhost

# PostgreSQL (POSTGRES_USER is the schema owner used by migrate)
POSTGRES_USER=cre_owner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cre
MIGRATE_DATABASE_URL=postgres://cre_owner:change-me@db:5432/cre?sslmode=disable
DATABASE_URL=postgres://cre_owner:change-me@db:5432/cre?sslmode=disable

VALKEY_ADDR=valkey:6379

# RustFS (S3 API)
S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1
S3_BUCKET=cre
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=change-me-too

GOTENBERG_URL=http://gotenberg:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mailpit in dev; Brevo SMTP relay in production
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost

SESSION_TTL=12h
REMEMBER_TTL=30d
SCORE_DECIMALS=2
RM_DECIMALS=3
