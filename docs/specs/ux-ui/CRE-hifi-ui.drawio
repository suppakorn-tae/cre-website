<mxCell id="c8025" value="" style="group;" vertex="1" parent="1"><mxGeometry x="1720" y="0" width="460" height="198" as="geometry" /></mxCell><mxCell id="c8026" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E3E8EF;strokeWidth=1;absoluteArcSize=1;arcSize=24;" vertex="1" parent="c8025"><mxGeometry x="0" y="0" width="460" height="198" as="geometry" /></mxCell><mxCell id="c8027" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F28C28;strokeColor=none;absoluteArcSize=1;arcSize=4;" vertex="1" parent="c8025"><mxGeometry x="16" y="18" width="8" height="8" as="geometry" /></mxCell><mxCell id="c8028" value="&lt;span style=&quot;color:#0F2A4A;font-weight:700&quot;&gt;Localisation (i18n) · ready for TH / EN&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;spacingTop=0;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%2BThai%3Awght%40400%3B500%3B600%3B700%26display%3Dswap;fontSize=13;fontColor=#0F2A4A;resizable=1;autosize=0;" vertex="1" parent="c8025"><mxGeometry x="32" y="12" width="412" height="20" as="geometry" /></mxCell><mxCell id="c8029" value="&lt;span style=&quot;color:#475569;font-weight:400&quot;&gt;Thai is the only UI language today; no language switch yet&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;spacingTop=0;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%2BThai%3Awght%40400%3B500%3B600%3B700%26display%3Dswap;fontSize=12;fontColor=#475569;resizable=1;autosize=0;" vertex="1" parent="c8025"><mxGeometry x="16" y="38" width="428" height="20" as="geometry" /></mxCell><mxCell id="c8030" value="&lt;span style=&quot;color:#475569;font-weight:400&quot;&gt;Every UI string comes from a message key (th.json), none in code&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;spacingTop=0;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%2BThai%3Awght%40400%3B500%3B600%3B700%26display%3Dswap;fontSize=12;fontColor=#475569;resizable=1;autosize=0;" vertex="1" parent="c8025"><mxGeometry x="16" y="60" width="428" height="20" as="geometry" /></mxCell><mxCell id="c8031" value="&lt;span style=&quot;color:#475569;font-weight:400&quot;&gt;Leave ≥ 30 % extra width for English labels; no fixed-width buttons&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;spacingTop=0;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%2BThai%3Awght%40400%3B500%3B600%3B700%26display%3Dswap;fontSize=12;fontColor=#475569;resizable=1;autosize=0;" vertex="1" parent="c8025"><mxGeometry x="16" y="82" width="428" height="20" as="geometry" /></mxCell><mxCell id="c8032" value="&lt;span style=&quot;color:#475569;font-weight:400&quot;&gt;Dates / numbers via the locale formatter: th = พ.ศ., en = CE&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;spacingTop=0;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%2BThai%3Awght%40400%3B500%3B600%3B700%26display%3Dswap;fontSize=12;fontColor=#475569;resizable=1;autosize=0;" vertex="1" parent="c8025"><mxGeometry x="16" y="104" width="428" height="20" as="geometry" /></mxCell><mxCell id="c8033" value="&lt;span style=&quot;color:#475569;font-weight:400&quot;&gt;Risk levels VL–VH, codes, units stay untranslated&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;spacingTop=0;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%2BThai%3Awght%40400%3B500%3B600%3B700%26display%3Dswap;fontSize=12;fontColor=#475569;resizable=1;autosize=0;" vertex="1" parent="c8025"><mxGeometry x="16" y="126" width="428" height="20" as="geometry" /></mxCell><mxCell id="c8034" value="&lt;span style=&quot;color:#475569;font-weight:400&quot;&gt;Admin content (advice) is stored per locale; th required&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;spacingTop=0;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%2BThai%3Awght%40400%3B500%3B600%3B700%26display%3Dswap;fontSize=12;fontColor=#475569;resizable=1;autosize=0;" vertex="1" parent="c8025"><mxGeometry x="16" y="148" width="428" height="20" as="geometry" /></mxCell><mxCell id="c8035" value="&lt;span style=&quot;color:#475569;font-weight:400&quot;&gt;Mixed Thai + English terms in one string is normal&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;spacingTop=0;fontFamily=IBM Plex Sans Thai;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%2BThai%3Awght%40400%3B500%3B600%3B700%26display%3Dswap;fontSize=12;fontColor=#475569;resizable=1;autosize=0;" vertex="1" parent="c8025"><mxGeometry x="16" y="170" width="428" height="20" as="geometry" /></mxCell><mxCell id="r26-note" value="&lt;b&gt;แก้ไข 26 พ.ย. 2569 · Foundations&lt;/b&gt;&lt;br&gt;&lt;ul style=&quot;margin:6px 0 0 0;padding-left:18px&quot;&gt;&lt;li style=&quot;margin-bottom:4px&quot;&gt;ความสูงควบคุม: ปุ่ม/ช่องกรอก md 36 px (เดิม 40), sm 30 px, lg 44 px (มือถือขั้นต่ำ 44 px สำหรับปุ่มหลัก)&lt;/li&gt;&lt;li style=&quot;margin-bottom:4px&quot;&gt;ช่องกรอก border-radius 6 px&lt;/li&gt;&lt;li style=&quot;margin-bottom:4px&quot;&gt;ห้ามใช้ &amp;lt;select&amp;gt; / date input ของเบราว์เซอร์: ใช้ Select, MultiSelect, DatePicker ของระบบ (คีย์บอร์ด + screen reader ได้)&lt;/li&gt;&lt;li style=&quot;margin-bottom:4px&quot;&gt;สีมิติ: EC #4C2A92 · SO #A8327A · EV #0E7490; tint 10 %: #EDEAF4 · #F6EAF2 · #E7F1F4 — แยกจากสีหลักของแอป (#1E5BC6), สี accent (#F28C28), สีสถานะ และสีระดับความเสี่ยง และแยกได้สำหรับคนตาบอดสี (มีรหัสข้อความกำกับเสมอ)&lt;/li&gt;&lt;li style=&quot;margin-bottom:4px&quot;&gt;Animation: 150–250 ms สำหรับ popup, 600–800 ms สำหรับกราฟ; ปิดทั้งหมดเมื่อ prefers-reduced-motion&lt;/li&gt;&lt;/ul&gt;" style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFF7D6;strokeColor=#D4A20A;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;fontFamily=IBM Plex Sans Thai;fontSize=13;fontColor=#3D2E00;" parent="1" vertex="1"><mxGeometry x="2240" y="0" width="600" height="520" as="geometry" /></mxCell></root></mxGraphModel></diagram>
