parent="1"><mxGeometry x="1590" y="516" width="34" height="26" as="geometry" /></mxCell><mxCell id="c283" value="&lt;b&gt;4.743&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Tahoma;fontSize=7;fontStyle=0;fontColor=#222222;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1630" y="516" width="36" height="26" as="geometry" /></mxCell><mxCell id="c284" value="VH" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Tahoma;fontSize=6.5;fontStyle=1;fillColor=#222222;fontColor=#ffffff;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="1672" y="517" width="22" height="12" as="geometry" /></mxCell><mxCell id="c285" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#dddddd;" vertex="1" parent="1"><mxGeometry x="1044" y="564" width="672" height="30" as="geometry" /></mxCell><mxCell id="c286" value="&lt;b&gt;คำอธิบาย:&lt;/b&gt;  RL = Risk Likelihood · RI&lt;sub&gt;C&lt;/sub&gt; = Risk Impact (Cost) · RI&lt;sub&gt;T&lt;/sub&gt; = Risk Impact (Time) · RI&lt;sub&gt;E&lt;/sub&gt; = Risk Impact (Environment) · RI&lt;sub&gt;max&lt;/sub&gt; = Maximum Impact · RM = Risk Magnitude = √(RL × RI&lt;sub&gt;max&lt;/sub&gt;)" style="text;html=1;whiteSpace=wrap;fontFamily=Tahoma;fontSize=6.5;fontStyle=0;fontColor=#222222;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1052" y="566" width="656" height="26" as="geometry" /></mxCell><mxCell id="c287" value="&lt;b&gt;Values as entered + score&lt;/b&gt;&lt;br&gt;Frequency in the indicator&amp;#x27;s unit -&amp;gt; RL; cost in baht (and % of project value 48.5M) -&amp;gt; RI&lt;sub&gt;C&lt;/sub&gt;; time in days (and % of 729-day duration) -&amp;gt; RI&lt;sub&gt;T&lt;/sub&gt;; options -&amp;gt; RI&lt;sub&gt;E&lt;/sub&gt; (A–C = 1, D–E = 2, F = 3, G = 4, H–I = 5, max of chosen, BR-02)." style="shape=note;size=10;whiteSpace=wrap;html=1;fontFamily=Tahoma;fontSize=7;align=left;ver