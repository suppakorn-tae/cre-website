ข้อมูลโครงการ" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Tahoma;fontSize=7;fillColor=#ffffff;fontColor=#222222;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="64" y="574" width="70" height="18" as="geometry" /></mxCell><mxCell id="c150" value="บันทึกคำตอบ" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Tahoma;fontSize=7;fillColor=#ffffff;fontColor=#222222;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="576" y="574" width="64" height="18" as="geometry" /></mxCell><mxCell id="c151" value="ส่งผลประเมิน ›" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Tahoma;fontSize=7;fillColor=#333333;fontColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="646" y="574" width="90" height="18" as="geometry" /></mxCell><mxCell id="c152" value="&lt;b&gt;คำถาม · EC-MG-2&lt;/b&gt;&lt;br&gt;X ความถี่ของเหตุการณ์ – โดยเฉลี่ยเกิดเหตุการณ์นี้กี่ครั้ง (หน่วย: % ของงบประมาณ)&lt;br&gt;&lt;font color='#bbb'&gt;[ข้อความคำถามจากแบบสอบถาม]&lt;/font&gt;" style="shape=callout;html=1;whiteSpace=wrap;fontFamily=Tahoma;fontSize=6.5;align=left;spacingLeft=6;spacingTop=-4;size=6;position=0.15;position2=0.12;base=8;fillColor=#222;fontColor=#fff;strokeColor=#222;" vertex="1" parent="1"><mxGeometry x="280" y="276" width="240" height="46" as="geometry" /></mxCell><mxCell id="c153" value="&lt;b&gt;UC-07&lt;/b&gt;&lt;br&gt;55 indicators (name_th) grouped by factor, one row each: frequency, cost impact, time impact, environment options. Answers saved as entered; may be left blank and continued later." style="shape=note;size=10;whiteSpace=wrap;html=1;fontFamily=Tahoma;fontSize=7;align=left;verticalAlign=top;spacing=6;fillColor=#fff2a8;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="780" y="80" width="200" height="70" as="geometry" /></mxCell><mxCell id="c154" value="&lt;b&gt;Units – FR-19&lt;/b&gt;&lt;br&gt;Cost unit (บาท or % of value 0–100) and time unit (วัน or % of duration 0–100) chosen once for all rows. Frequency unit is fixed per indicator (from the indicator reference)." style="shape=note;size=10;whiteSpace=wrap;html=1;fontFamily=Tahoma;fontSize=7;align=left;verticalAlign=top;spacing=6;fillColor=#fff2a8;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="780" y="162" width="200" height="70" as="geometry" /></mxCell><mxCell id="c155" value="&lt;b&gt;Focus &amp;amp; status&lt;/b&gt;&lt;br&gt;Focusing a cell shows its question above it. Complete row = green; factor header gets a tick when all 5 are complete; dropdown filters by factor." style="shape=note;size=10;whiteSpace=wrap;html=1;fontFamily=Tahoma;fontSize=7;align=left;verticalAlign=top;spacing=6;fillColor=#fff2a8;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="780" y="244" width="200" height="70" as="geometry" /></mxCell><mxCell id="c156" value="&lt;b&gt;No scores yet – BR-09&lt;/b&gt;&lt;br&gt;Scores appear only after ส่งผลประเมิน; then 3.3b results." style="shape=note;size=10;whiteSpace=wrap;html=1;fontFamily=Tahoma;fontSize=7;align=left;verticalAlign=top;spacing=6;fillColor=#fff2a8;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="780" y="326" width="200" height="70" as="geometry" /></mxCell><mxCell id="c157" value="3.2 ประเมินความเสี่ยง – ข้อผิดพลาด" style="text;html=1;whiteSpace=wrap;fontFamily=Tahoma;fontSize=12;fontStyle=1;fontColor=#222222;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1020" y="54" width="720" height="20" as="geometry" /></mxCell><mxCell id="c158" value="" style="rounded=0;html=1;fillColor=#f7f7f7;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1020" y="80" width="720" height="520" as="geometry" /></mxCell><mxCell id="c159" value="" style="html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1020" y="80" width="720" height="32" as="geometry" /></mxCell><mxCell id="c160" value="CRE" style="rounded=1;html=1;fontFamily=Tahoma;fontSize=5;fontStyle=1;fillColor=#333333;fontColor=#ffffff;strokeColor=none