"1570" y="314" width="130" height="14" as="geometry" /></mxCell><mxCell id="c81" value="ความก้าวหน้า จริง &lt;b&gt;45%&lt;/b&gt; · ตามแผน 48%" style="text;html=1;whiteSpace=wrap;fontFamily=Tahoma;fontSize=6.5;fontStyle=0;fontColor=#222222;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1500" y="334" width="200" height="14" as="geometry" /></mxCell><mxCell id="c82" value="" style="html=1;fillColor=#ddd;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1500" y="352" width="200" height="4" as="geometry" /></mxCell><mxCell id="c83" value="" style="html=1;fillColor=#333;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1500" y="352" width="90.0" height="4" as="geometry" /></mxCell><mxCell id="c84" value="" style="html=1;fillColor=#ddd;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1500" y="362" width="200" height="4" as="geometry" /></mxCell><mxCell id="c85" value="" style="html=1;fillColor=#888;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1500" y="362" width="96.0" height="4" as="geometry" /></mxCell><mxCell id="c86" value="จริง (เข้ม) · ตามแผน (เทา)" style="text;html=1;whiteSpace=wrap;fontFamily=Tahoma;fontSize=6;fontStyle=0;fontColor=#888;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1500" y="370" width="200" height="12" as="geometry" /></mxCell><mxCell id="c87" value="&lt;b&gt;Fields&lt;/b&gt;&lt;br&gt;ชื่อโครงการ, ชื่อเล่น (slug, 3–4 ตัวอักษร), เกาะ (choose or อื่นๆ then type), ประเภท (อาคาร / ที่พัก, ท่าเรือ, ถนน / โครงสร้างพื้นฐาน, ระบบสาธารณูปโภค, โครงสร้างชายฝั่ง, อื่นๆ), วันเริ่ม–สิ้นสุด, มูลค่า, % ความก้าวหน้า (default 0), รายละเอียด ไม่บังคับ. ประเภท = chips (เลือก 1); อื่นๆ → ช่องกรอกข้อความ (บังคับ)." style="shape=note;size=10;whiteSpace=wrap;html=1;fontFamily=Tahoma;fontSize=7;align=left;verticalAlign=top;spacing=6;fillColor=#fff2a8;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1760" y="80" width="200" height="70" as="geometry" /></mxCell><mxCell id="c88" value="&lt;b&gt;Progress&lt;/b&gt;&lt;br&gt;Actual % entered by the user; expected % calculated from start / end dates and shown next to it." style="shape=note;size=10;whiteSpace=wrap;html=1;fontFamily=Tahoma;fontSize=7;align=left;verticalAlign=top;spacing=6;fillColor=#fff2a8;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1760" y="162" width="200" height="70" as="geometry" /></mxCell><mxCell id="c89" value="&lt;b&gt;Preview &amp;amp; save&lt;/b&gt;&lt;br&gt;Right panel previews the project in real time. Validates required fields and end after start. Save -&amp;gt; goes straight to step 2 ประเมินความเสี่ยง (3.1). Edit uses the same form." style="shape=note;size=10;whiteSpace=wrap;html=1;fontFamily=Tahoma;fontSize=7;align=left;verticalAlign=top;spacing=6;fillColor=#fff2a8;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1760" y="244" width="200" height="70" as="geometry" /></mxCell><mxCell id="c90" value="2.3 หน้าโครงการ – แท็บภาพรวม" style="text;html=1;whiteSpace=wrap;fontFamily=Tahoma;fontSize=12;fontStyle=1;fontColor=#222222;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2000" y="54" width="720" height="20" as="geometry" /></mxCell><mxCell id="c91" value="" style="rounded=0;html=1;fillColor=#f7f7f7;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="2000" y="80" width="720" height="520" as="geometry" /></mxCell><mxCell id="c92" value="" style="html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="2000" y="80" width="720" height="32" as="geometry" /></mxCell><mxCell id="c93" value="CRE" style="rounded=1;html=1;fontFamily=Tahoma;fontSize=5;fontStyle=1;fillColor=#333333;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2016" y="88" width="16" height="16" as="geometry" /></mxCell><mxCell id="c94" value="&lt;b&gt;CRE&lt;/b&gt;&lt;br&gt;&lt;font color='#777777' style='font-size:5p