        <mxCell id="lg1_ic" value="" style="shape=module;jettyWidth=8;jettyHeight=4;html=1;" vertex="1" parent="lg1"><mxGeometry x="1" width="16" height="16" relative="1" as="geometry"><mxPoint x="-22" y="5" as="offset"/></mxGeometry></mxCell>
        <mxCell id="lg2" value="&lt;span style=&quot;font-size:10px&quot;&gt;«component»&lt;/span&gt;&lt;br&gt;&lt;b&gt;Data store&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dropTarget=0;fillColor=#F7C6EC;strokeColor=#B3479A;strokeWidth=1.2;verticalAlign=middle;spacingTop=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="65" y="448" width="190" height="36" as="geometry"/></mxCell>
        <mxCell id="lg2_ic" value="" style="shape=module;jettyWidth=8;jettyHeight=4;html=1;" vertex="1" parent="lg2"><mxGeometry x="1" width="16" height="16" relative="1" as="geometry"><mxPoint x="-22" y="5" as="offset"/></mxGeometry></mxCell>
        <mxCell id="lg3" value="&lt;span style=&quot;font-size:10px&quot;&gt;«component»&lt;/span&gt;&lt;br&gt;&lt;b&gt;Docker container&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dropTarget=0;fillColor=#DDF5DA;strokeColor=#4E9F4E;strokeWidth=1.2;verticalAlign=middle;spacingTop=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="65" y="491" width="190" height="36" as="geometry"/></mxCell>
        <mxCell id="lg3_ic" value="" style="shape=module;jettyWidth=8;jettyHeight=4;html=1;" vertex="1" parent="lg3"><mxGeometry x="1" width="16" height="16" relative="1" as="geometry"><mxPoint x="-22" y="5" as="offset"/></mxGeometry></mxCell>
        <mxCell id="lg4" value="&lt;span style=&quot;font-size:10px&quot;&gt;«component»&lt;/span&gt;&lt;br&gt;&lt;b&gt;One-off container&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dropTarget=0;fillColor=#7BEF78;strokeColor=#2E9A2E;strokeWidth=1.2;verticalAlign=middle;spacingTop=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="65" y="534" width="190" height="36" as="geometry"/></mxCell>
        <mxCell id="lg4_ic" value="" style="shape=module;jettyWidth=8;jettyHeight=4;html=1;" vertex="1" parent="lg4"><mxGeometry x="1" width="16" height="16" relative="1" as="geometry"><mxPoint x="-22" y="5" as="offset"/></mxGeometry></mxCell>
        <mxCell id="lg5" value="&lt;span style=&quot;font-size:10px&quot;&gt;«component»&lt;/span&gt;&lt;br&gt;&lt;b&gt;External system&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dropTarget=0;fillColor=#FCD8BC;strokeColor=#D0864A;strokeWidth=1.2;verticalAlign=middle;spacingTop=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="65" y="577" width="190" height="36" as="geometry"/></mxCell>
        <mxCell id="lg5_ic" value="" style="shape=module;jettyWidth=8;jettyHeight=4;html=1;" vertex="1" parent="lg5"><mxGeometry x="1" width="16" height="16" relative="1" as="geometry"><mxPoint x="-22" y="5" as="offset"/></mxGeometry></mxCell>
        <mxCell id="lg_grp" value="&lt;span style=&quot;color:#7A4FA8&quot;&gt;&lt;b&gt;Logical layer&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#A678D6;strokeWidth=2;verticalAlign=middle;spacingBottom=6;fontSize=11;dropTarget=0;" vertex="1" parent="1"><mxGeometry x="65" y="620" width="190" height="30" as="geometry"/></mxCell>
        <mxCell id="lg_n0" value="Docker network (public)" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 5;strokeWidth=1.6;fillColor=#FEF2E3;strokeColor=#D99A2B;fontColor=#D99A2B;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="65" y="658" width="190" height="30" as="geometry"/></mxCell>
        <mxCell id="lg_n1" value="Docker network (private)" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 5;strokeWidth=1.6;fillColor=#E9EEFA;strokeColor=#4F7DB8;fontColor=#4F7DB8;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="65" y="696" width="190" height="30" as="geometry"/></mxCell>
        <mxCell id="lg_n2" value="Docker network (egress)" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 5;strokeWidth=1.6;fillColor=#FDEBEA;strokeColor=#C0504D;fontColor=#C0504D;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="65" y="734" width="190" height="30" as="geometry"/></mxCell>
        <mxCell id="lg_cyl" value="Docker volume" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#E0E0E0;strokeColor=#777777;fontSize=10;" vertex="1" parent="1"><mxGeometry x="110" y="774" width="100" height="46" as="geometry"/></mxCell>
        <mxCell id="lg_port" value="" style="ellipse;html=1;aspect=fixed;fillColor=#7CC7F0;strokeColor=#2C7FB8;strokeWidth=1.2;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="149" y="829" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="lg_pt" value="&lt;b&gt;Interface (port)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="65" y="852" width="190" height="16" as="geometry"/></mxCell>
        <mxCell id="notes" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Design notes&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;margin-top:6px&quot;&gt;1. Networks: &lt;b&gt;public-net&lt;/b&gt; = caddy only (:80/:443 published). &lt;b&gt;private-net&lt;/b&gt; (internal: true) = every container, no host ports. &lt;b&gt;egress-net&lt;/b&gt; = api and backup only, outbound HTTPS to Google, the e-mail service and the off-site backup repository.&lt;/div&gt;&lt;div style=&quot;margin-top:4px&quot;&gt;2. Caddy: handle /api/v* → api:4000, everything else → web:3000; path not stripped. Same origin → no CORS.&lt;/div&gt;&lt;div style=&quot;margin-top:4px&quot;&gt;3. api layers depend downward only: HTTP → Service → DAL / Adapters. Domain models import nothing; types and fields follow Database Design v1.1.&lt;/div&gt;&lt;div style=&quot;margin-top:4px&quot;&gt;4. Sign-up: e-mail + password with a 6-digit OTP, or Google (OIDC code flow inside api). OTPs, pending sign-ups and rate limits live in Valkey with a TTL; the account row is created only after verification.&lt;/div&gt;&lt;div style=&quot;margin-top:4px&quot;&gt;5. Session: JWT in an httpOnly cookie. Middleware re-checks account status, role and session version on every request, so reset, deactivate and delete take effect at once.&lt;/div&gt;&lt;div style=&quot;margin-top:4px&quot;&gt;6. A version = blank answers + immutable snapshot (project value, dates, thresholds, rounding) stored as typed rows. Scoring runs on submit, reads the snapshot only, and stores the results.&lt;/div&gt;&lt;div style=&quot;margin-top:4px&quot;&gt;7. Repositories enforce owner scope and deleted_at IS NULL. Admins cannot open users&amp;#x27; projects — counts only.&lt;/div&gt;&lt;div style=&quot;margin-top:4px&quot;&gt;8. Every admin change writes its audit_log row in the same transaction; the table is append-only.&lt;/div&gt;&lt;div style=&quot;margin-top:4px&quot;&gt;9. Reports and research exports are async: 202 + job id → worker → RustFS → poll status → download through api (auth-checked stream). Export files expire after 7 days.&lt;/div&gt;&lt;div style=&quot;margin-top:4px&quot;&gt;10. Start order: db, valkey, rustfs healthy → migrate done → api, worker → web → caddy.&lt;/div&gt;&lt;div style=&quot;margin-top:4px&quot;&gt;11. Volumes: pgdata, valkey-data (AOF on), rustfs-data, caddy-data.&lt;/div&gt;&lt;div style=&quot;margin-top:4px&quot;&gt;12. Backup is optional: profile backup starts pgBackRest, WAL archiving, off-site copies and the reports mirror; without it the container is absent and archive_mode=off — no backups, no RPO/RTO.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontSize=10;fillColor=#FFFDF0;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="28" y="896" width="264" height="610" as="geometry"/></mxCell>
      <mxCell id="backup" value="«optional container»&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;&lt;b&gt;backup — pgBackRest&lt;/b&gt;&lt;/span&gt;&lt;br&gt;profile: backup · private-net + egress-net" style="rounded=0;whiteSpace=wrap;html=1;dropTarget=0;fillColor=#DDF5DA;strokeColor=#4E9F4E;strokeWidth=1.2;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2258" y="1070" width="390" height="300" as="geometry"/></mxCell><mxCell id="backup_ic" value="" style="shape=module;jettyWidth=8;jettyHeight=4;html=1;" vertex="1" parent="backup"><mxGeometry x="1" width="16" height="16" relative="1" as="geometry"><mxPoint x="-22" y="5" as="offset"/></mxGeometry></mxCell><mxCell id="bk_repo" value="«component»&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;&lt;b&gt;pgBackRest&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;WAL archive (TLS :8432) · full weekly · diff daily&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;PITR ≈ 5 weeks · monthly fulls 12 months&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;zstd + AES-256 · repo on off-site S3&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;dropTarget=0;fillColor=#C8F0F6;strokeColor=#2A93AB;strokeWidth=1.2;verticalAlign=middle;spacingTop=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2276" y="1132" width="354" height="82" as="geometry"/></mxCell><mxCell id="bk_repo_ic" value="" style="shape=module;jettyWidth=8;jettyHeight=4;html=1;" vertex="1" parent="bk_repo"><mxGeometry x="1" width="16" height="16" relative="1" as="geometry"><mxPoint x="-22" y="5" as="offset"/></mxGeometry></mxCell><mxCell id="bk_mirror" value="«component»&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Object Mirror&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;nightly copy of reports/ (S3 API)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;exports/ not copied (expire in 7 days)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;dropTarget=0;fillColor=#C8F0F6;strokeColor=#2A93AB;strokeWidth=1.2;verticalAlign=middle;spacingTop=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2276" y="1224" width="354" height="68" as="geometry"/></mxCell><mxCell id="bk_mirror_ic" value="" style="shape=module;jettyWidth=8;jettyHeight=4;html=1;" vertex="1" parent="bk_mirror"><mxGeometry x="1" width="16" height="16" relative="1" as="geometry"><mxPoint x="-22" y="5" as="offset"/></mxGeometry></mxCell><mxCell id="x_backup" value="«external system»&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Off-site Backup Storage&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;S3 bucket · other provider / region · object lock&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;dropTarget=0;fillColor=#FCD8BC;strokeColor=#D0864A;strokeWidth=1.2;verticalAlign=middle;spacingTop=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2318" y="1454" width="270" height="64" as="geometry"/></mxCell><mxCell id="x_backup_ic" value="" style="shape=module;jettyWidth=8;jettyHeight=4;html=1;" vertex="1" parent="x_backup"><mxGeometry x="1" width="16" height="16" relative="1" as="geometry"><mxPoint x="-22" y="5" as="offset"/></mxGeometry></mxCell><mxCell id="e_dbbk" value="WAL · backups (when enabled)" style="html=1;rounded=0;strokeColor=#333333;strokeWidth=1.1;fontSize=11;dashed=1;endArrow=open;endSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="db" target="bk_repo"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2240" y="621"/><mxPoint x="2240" y="1173"/></Array></mxGeometry></mxCell><mxCell id="e_bkrf" value="mirror reports/" style="html=1;rounded=0;strokeColor=#333333;strokeWidth=1.1;fontSize=11;dashed=1;endArrow=open;endSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="bk_mirror" target="rustfs"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2022" y="1258"/></Array></mxGeometry></mxCell><mxCell id="e_bkx" value="HTTPS :443 · S3" style="html=1;rounded=0;strokeColor=#333333;strokeWidth=1.1;fontSize=11;dashed=1;endArrow=open;endSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="backup" target="x_backup"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root>
    </mxGraphModel>
  </diagram>
</mxfile>
