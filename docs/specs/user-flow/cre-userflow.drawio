eometry x="904" y="504" width="180" height="22" as="geometry"/></mxCell><mxCell id="nt1" value="&lt;b&gt;Rules&lt;/b&gt;&lt;br&gt;• An indicator is complete when X, y&lt;sub&gt;1&lt;/sub&gt;, y&lt;sub&gt;2&lt;/sub&gt;, y&lt;sub&gt;3&lt;/sub&gt; are all given (BR-09).&lt;br&gt;• Scores are shown only after submission.&lt;br&gt;• Only the latest version is editable (BR-11).&lt;br&gt;• Advice and strategy exist only for H / VH indicators (BR-05, BR-19)." style="shape=note;size=12;align=left;spacingLeft=8;spacingRight=6;whiteSpace=wrap;html=1;fontSize=11;fontColor=#1a1a1a;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1170" y="290" width="290" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4 Account &amp; log-out"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1980" pageHeight="1040" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="CRE User Flow — 4. Account &amp;amp; log-out" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="60" y="24" width="900" height="30" as="geometry"/></mxCell><mxCell id="subtitle" value="UC-03 Log out · UC-04 Manage own account. Source: CRE Requirements &amp;amp; Use Case Specification v1.14 (23 Nov 2026)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="60" y="54" width="1100" height="22" as="geometry"/></mxCell><mxCell id="start" value='&lt;b&gt;Logged in&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;global menu on any page&lt;/font&gt;' style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=12;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;" vertex=