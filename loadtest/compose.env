# Throw-away values for the load test stack only. Never use them elsewhere.
COMPOSE_PROJECT_NAME=cre-loadtest
PUBLIC_BASE_URL=https://localhost
APP_ENV=production
SESSION_SECRET=loadtest-only-session-secret-0123456789abcdef0123456789abcdef
SESSION_TTL=12h
REMEMBER_TTL=30d

POSTGRES_USER=cre_owner
POSTGRES_PASSWORD=loadtest-db-password
POSTGRES_DB=cre
APP_DB_PASSWORD=loadtest-app
MIGRATE_DATABASE_URL=postgres://cre_owner:loadtest-db-password@db:5432/cre?sslmode=disable
DATABASE_URL=postgres://cre_app:loadtest-app@db:5432/cre?sslmode=disable

VALKEY_ADDR=valkey:6379

S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1
S3_BUCKET=cre
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=loadtest-rustfs-secret

GOTENBERG_URL=http://gotenberg:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost
# Production mode requires STARTTLS by default; Mailpit offers none.
SMTP_REQUIRE_TLS=false

SCORE_DECIMALS=2
RM_DECIMALS=3

# The seed gives each user 10 projects and 5 versions per project, so the
# limits must be at least that high.
MAX_PROJECTS_PER_USER=10
MAX_VERSIONS_PER_PROJECT=10
